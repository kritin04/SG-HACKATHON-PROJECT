# Copy to .env and fill in. Leave JIRA_BASE_URL empty to use the demo files in demo_data/jira.
# Local demo tracker (jira_sim):
JIRA_BASE_URL=http://localhost:8090
# Real Jira Cloud instead (create a token at https://id.atlassian.com/manage-profile/security/api-tokens):
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=xxxxxxxx
JIRA_JQL=project = BOA ORDER BY created ASC
# JIRA_AC_FIELD=customfield_10040
